#!/usr/bin/env just --justfile
#
# The TypeScript driver, invoked from the repo root as `just ts <recipe>`. Its crates
# are their own workspace on ts/rust-toolchain.toml's nightly, which the dev shell
# exports as RUST2_TS_TOOLCHAIN; without it, rustup reads the same file.

set shell := ["bash", "-euo", "pipefail", "-c"]

export PATH := if env("RUST2_TS_TOOLCHAIN", "") == "" { env("PATH") } else { env("RUST2_TS_TOOLCHAIN") / "bin:" + env("PATH") }

default:
    @just --list

# Lint and format-check the driver and its fixtures.
check:
    cargo clippy --locked --all-targets -- -D warnings
    cargo fmt --all --check
    cargo shear
    cargo sort --workspace --check --no-format
    tsc -p runtime --noEmit

# Run the snapshot and differential tests.
test *args:
    cargo test --locked {{ args }}

# Apply formatters without changing program behavior.
fix:
    cargo clippy --locked --fix --allow-staged --allow-dirty --all-targets
    cargo fmt --all
    cargo shear --fix
    cargo sort --workspace --no-format

# Run the driver: `just ts run --config <ts.toml> --out <dir>`.
run *args:
    cargo run --locked --quiet -- {{ args }}

# Run cargo on the pinned nightly.
cargo *args:
    cargo {{ args }}
