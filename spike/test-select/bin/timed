#!/usr/bin/env python3
"""Usage: timed PREFIX cmd args...

Run cmd through quest gate, logging to PREFIX.log and CPU and wall seconds to PREFIX.time.
"""
import resource, subprocess, sys, time

prefix, cmd = sys.argv[1], sys.argv[2:]
start = time.monotonic()
with open(prefix + '.log', 'w') as log:
    status = subprocess.run(['quest', 'gate', *cmd], stdout=log, stderr=subprocess.STDOUT).returncode
wall = time.monotonic() - start
r = resource.getrusage(resource.RUSAGE_CHILDREN)
summary = f'exit={status} user={r.ru_utime:.1f} sys={r.ru_stime:.1f} wall={wall:.1f} maxrss_kb={r.ru_maxrss}'
open(prefix + '.time', 'w').write(summary + '\n')
print(summary)
print(''.join(open(prefix + '.log').readlines()[-3:]))
sys.exit(status)
