#!/usr/bin/env just --justfile
#
# The C exporter, invoked from the repo root as `just ffi <recipe>`. Its crates are their
# own workspace on ts/rust-toolchain.toml's nightly, which the dev shell exports as
# RUST2_TS_TOOLCHAIN; without it, rustup reads the same file through the link here.

set shell := ["bash", "-euo", "pipefail", "-c"]

export PATH := if env("RUST2_TS_TOOLCHAIN", "") == "" { env("PATH") } else { env("RUST2_TS_TOOLCHAIN") / "bin:" + env("PATH") }

default:
    @just --list

# Lint and format-check the exporter and its fixtures.
check:
    cargo clippy --locked --all-targets -- -D warnings
    cargo fmt --all --check
    cargo shear
    cargo sort --workspace --check --no-format

# Export each fixture, build it, and run its C test.
test *args:
    cargo test --locked {{ args }}

# Apply formatters without changing program behavior.
fix:
    cargo clippy --locked --fix --allow-staged --allow-dirty --all-targets
    cargo fmt --all
    cargo shear --fix
    cargo sort --workspace --no-format

# Run the exporter: `just ffi run --config <ffi.toml> --out <dir>`.
run *args:
    cargo run --locked --quiet -- {{ args }}

# Census each package moq/ffi.toml exports into target/census/<package>.md, from the moq revision `just ts moq` pins or a checkout.
census checkout="": (standin checkout)
    cargo run --locked --quiet -- --config moq/ffi.toml --manifest-path target/moq-ffi/Cargo.toml --census target/census

# Time frame writes through the export, from C, C++, and Kotlin, and through moq's hand-written rs/moq-c, in the bench shell: nix develop .#bench.
bench checkout="": (moq checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    [ -n "${LIBCLANG_PATH:-}" ] || { echo "LIBCLANG_PATH is unset: run this in the bench shell, nix develop .#bench" >&2; exit 1; }
    src="{{ checkout }}"
    [ -n "$src" ] || src=../ts/target/moq
    out=target/export/moq
    # moq-c's header is written to its build script's output directory.
    moqc=$(cd "$src" && cargo build --locked --quiet --release --package moq-c --message-format=json \
        | jq -r 'select(.reason == "build-script-executed" and (.package_id | contains("moq-c#"))) | .out_dir')
    cc -O2 -std=c11 -Wall -Wextra -Werror -I "$out/include" moq/bench/export.c "$out/target/release/libmoq.a" -lpthread -ldl -lm -o target/bench-export
    cc -O2 -std=c11 -Wall -Wextra -Werror -I "$moqc/include" moq/bench/moq-c.c "$src/target/release/libmoq.a" -lpthread -ldl -lm -o target/bench-moq-c
    c++ -O2 -std=c++17 -Wall -Wextra -Werror -I "$out/include" moq/bench/export.cpp "$out/target/release/libmoq.a" -lpthread -ldl -lm -o target/bench-export-cpp
    rm -rf target/bench-kt
    kotlinc -Werror -cp "$KOTLINX_COROUTINES" "$out/kotlin/moq.kt" moq/bench/export.kt -d target/bench-kt
    for _ in 1 2 3; do
        target/bench-moq-c
        target/bench-export
        target/bench-export-cpp
        kotlin -Djava.library.path="$out/target/release" -cp "target/bench-kt:$KOTLINX_COROUTINES" ExportKt
    done

# Export moq's crates' C ABI, build it, and run moq/moq.c, moq/moq.cpp, and moq/moq.kt against it, from the moq revision `just ts moq` pins or a checkout.
moq checkout="": (standin checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    out=target/export/moq
    cargo run --locked --quiet -- --config moq/ffi.toml --manifest-path target/moq-ffi/Cargo.toml --out "$out"
    # The lockfile the check resolved with pins what the export depends on.
    cp target/moq-ffi/Cargo.lock "$out/Cargo.lock"
    # A later nightly makes this future-compat lint a hard error; fail on it in moq's crates
    # and the glue now, while the pin can still move.
    RUSTFLAGS="-D recursion_depth_exceeding_limit" cargo build --quiet --release --manifest-path "$out/Cargo.toml" --features kotlin
    cc -std=c11 -pedantic -Wall -Wextra -Werror -I "$out/include" moq/moq.c "$out/target/release/libmoq.a" -lpthread -ldl -lm -o target/moq-test
    target/moq-test
    # The C++ header at OBS's standard, without exceptions or RTTI.
    c++ -std=c++17 -fno-exceptions -fno-rtti -pedantic -Wall -Wextra -Werror -I "$out/include" moq/moq.cpp "$out/target/release/libmoq.a" -lpthread -ldl -lm -o target/moq-cpp-test
    target/moq-cpp-test
    # The Kotlin, on the JVM, through the JNI functions the kotlin feature builds.
    rm -rf target/moq-kt
    kotlinc -Werror -cp "$KOTLINX_COROUTINES" "$out/kotlin/moq.kt" moq/moq.kt -d target/moq-kt
    kotlin -Djava.library.path="$out/target/release" -cp "target/moq-kt:$KOTLINX_COROUTINES" MoqKt

# Write target/moq-ffi, an empty library on every crate moq/ffi.toml exports, from the moq revision `just ts moq` pins or a checkout: the check builds with all of them, as moq-ffi's remainder will.
[private]
standin checkout="":
    #!/usr/bin/env bash
    set -euo pipefail
    src="{{ checkout }}"
    if [ -z "$src" ]; then
        (cd ../ts && just moq-pin)
        src=../ts/target/moq
    fi
    src=$(realpath "$src")
    dir=target/moq-ffi
    # moq-ffi's dependencies among the exports, moq-tokio with its default features as
    # moq-ffi has them, and moq-pattern and kio, which moq-ffi reaches through moq-net.
    exports=(hang kio moq-clock moq-mux moq-net moq-pattern moq-tokio)
    mkdir -p "$dir/src"
    {
        printf '# Generated by just ffi standin, from %s.\n' "$src"
        printf '[package]\nname = "moq-ffi"\nversion = "0.0.0"\nedition = "2024"\npublish = false\n\n[dependencies]\n'
        for name in "${exports[@]}"; do
            printf '%s = { path = "%s/rs/%s" }\n' "$name" "$src" "$name"
        done
        printf '\n[workspace]\n'
    } > "$dir/Cargo.toml"
    # rustc loads a dependency only once the crate names it.
    for name in "${exports[@]}"; do
        printf 'use %s as _;\n' "${name//-/_}"
    done > "$dir/src/lib.rs"
    # moq's lockfile pins what moq's own builds use.
    cp "$src/Cargo.lock" "$dir/Cargo.lock"
